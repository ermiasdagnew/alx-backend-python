{
  "info": {
    "name": "Messaging App API",
    "_postman_id": "12345-abcde-67890-fghij",
    "description": "Postman collection to test Messaging App API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get JWT Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"<your-username>\",\n    \"password\": \"<your-password>\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/token/",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "token"]
        }
      },
      "response": []
    },
    {
      "name": "List Conversations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <your-access-token>"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/conversations/",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "conversations"]
        }
      },
      "response": []
    }
  ]
}
