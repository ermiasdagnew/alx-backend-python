#!/bin/bash

# Task 0: Start Minikube cluster, verify it, and list pods

# 1. Check if Minikube is installed
if ! command -v minikube &> /dev/null; then
    echo "❌ Minikube is not installed. Please install Minikube first."
    exit 1
fi

# 2. Start Minikube cluster
echo "🚀 Starting Minikube cluster..."
minikube start --driver=docker

# 3. Verify cluster is running
echo "🔍 Checking Kubernetes cluster status..."
kubectl cluster-info

# 4. List all pods in all namespaces
echo "📦 Listing all pods in all namespaces..."
kubectl get pods --all-namespaces

echo "✅ Task 0 complete: Minikube cluster is running and verified."
