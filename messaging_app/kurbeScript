#!/bin/bash
# kurbeScript: Setup and verify a local Kubernetes cluster using Minikube

# Exit immediately if a command fails
set -e

# Function to check if minikube is installed
check_minikube() {
    if ! command -v minikube &> /dev/null; then
        echo "Minikube is not installed. Please install Minikube first."
        exit 1
    fi
}

# Function to start the Kubernetes cluster
start_cluster() {
    echo "Starting Minikube cluster..."
    minikube start
}

# Function to verify cluster info
verify_cluster() {
    echo "Verifying Kubernetes cluster..."
    kubectl cluster-info
}

# Function to list available pods
list_pods() {
    echo "Retrieving available pods..."
    kubectl get pods -A
}

# Main script execution
check_minikube
start_cluster
verify_cluster
list_pods

echo "Kubernetes cluster setup complete ✅"
